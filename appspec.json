{
  "version": "1.2",
  "settings": [
    {
      "id": "file.name",
      "name": "File name",
      "description": "Insert a file name for your shapefile folder(s) and files, without spaces. If left empty, `moveapps-shapefile` is used.",
      "defaultValue": "moveapps-shapefile",
      "type": "STRING"
    },
    {
      "id": "pts",
      "name": "Points shapefile",
      "description": "Select if you want to create a zipped set of shapefiles containing the points (locations) of the data set.",
      "defaultValue": true,
      "type": "CHECKBOX"
    },
    {
      "id": "seg",
      "name": "Line segments shapefile",
      "description": "Select if you want to create a zipped set of shapefiles containing the line segments between successive locations of the data set.",
      "defaultValue": false,
      "type": "CHECKBOX"
    },
    {
      "id": "lins",
      "name": "Track lines shapefile",
      "description": "Select if you want to create a zipped set of shapefiles containing one line per track, including the track attributes.",
      "defaultValue": false,
      "type": "CHECKBOX"
    },
    {
      "id": "gpkg",
      "name": "GeoPackage file(s)",
      "description": "Select if you want additional *.gpkg files created for the selected outputs (points, segments, lines). GeoPackages keep the original attribute names and full timestamps.",
      "defaultValue": false,
      "type": "CHECKBOX"
    }
  ],
  "dependencies": {
    "R": [
      {
        "name": "move2"
      },
      {
        "name": "sf"
      },
      {
        "name": "dplyr"
      },
      {
        "name": "zip"
      }
    ]
  },
  "providedAppFiles": [
    {
      "settingId": "vocab",
      "from": "data/auxiliary/user-files/provided-app-files/vocab/MovebankVocab_ShapefileNamesF.csv"
    }
  ],
  "license": {
    "key": "MIT"
  },
  "language": "eng",
  "keywords": [
    "shapefile",
    "shp",
    "dbf",
    "gpkg",
    "geopackage",
    "write",
    "GIS",
    "export",
    "lines",
    "segments",
    "points"
  ],
